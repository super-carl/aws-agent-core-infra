        <mxCell id="e_rt_secrets" value="read creds" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;fontSize=10;" edge="1" parent="1" source="runtime" target="secrets"><mxGeometry relative="1" as="geometry" /></mxCell>
