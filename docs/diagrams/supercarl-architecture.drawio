        <!-- Legend -->
        <mxCell id="legend" value="Flow: Client → API Gateway (+Cognito) → Orchestrator (async worker) → AgentCore Runtime → SuperCarl MCP (search/read only) → deliver_results → SES/Slack/S3.  State in DynamoDB.  Write-capable MCP tools are excluded by allowlist." style="text;html=1;strokeColor=#CBD3DA;fillColor=#F8FAFB;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=10;fontColor=#5A6673;spacing=8;" vertex="1" parent="1">
