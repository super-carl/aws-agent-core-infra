meta {
  name: 6 - Schedule a recurring run
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}research/schedule
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "prompt": "Senior data engineers in Denver",
    "useCase": "recruiting",
    "channels": ["slack"],
    "scheduleExpression": "rate(1 day)"
  }
}
